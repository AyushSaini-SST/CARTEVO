# Backend server
PORT=8001
NODE_ENV=development

# MongoDB connection string (replace with your own local or Atlas URI)
MONGO_URL=mongodb://127.0.0.1:27017/cartevo

# Replace with a cryptographically random secret (at least 32 bytes)
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated frontend origins allowed to make credentialed API requests
CLIENT_URL=http://localhost:5173

# Razorpay credentials: use test keys locally; keep the secret private
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-test-secret
